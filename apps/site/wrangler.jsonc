{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zorion-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/admin/api/*", "/api/*"]
  },
  "routes": [{ "pattern": "zorion.midnightpoetry.studio", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://zorionapp.midnightpoetry.studio",
    "SITE_ORIGIN": "https://zorion.midnightpoetry.studio",
    // Shown on the privacy and terms pages. Set it before launch.
    "CONTACT_EMAIL": ""
  }
  // Secrets (set with `wrangler secret put`): DATABASE_URL, PEPPER, TOTP_KEY (the same values as zorion-app)
}
