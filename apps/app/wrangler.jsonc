{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zorion-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "zorionapp.midnightpoetry.studio", "custom_domain": true }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://zorionapp.midnightpoetry.studio",
    "SITE_ORIGIN": "https://zorion.midnightpoetry.studio",
    "PLACES_PROVIDER": "osm"
  }
  // Secrets (set with `wrangler secret put`): DATABASE_URL, PEPPER, TOTP_KEY, RESEND_API_KEY, EMAIL_FROM,
  // GOOGLE_PLACES_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_MONTHLY, STRIPE_PRICE_YEARLY
  // Optional: GOOGLE_ROUTES_KEY (routed trip times; falls back to GOOGLE_PLACES_KEY), OVERPASS_URL and NOMINATIM_URL (your own map servers)
}
