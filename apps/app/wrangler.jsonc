{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zorion-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "zorionapp.midnightpoetry.studio", "custom_domain": true }],
  "observability": { "enabled": true },
  // Serve only the custom domain: no *.workers.dev address and no preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  // Keep variables added in the Cloudflare dashboard when Git deploys run.
  "keep_vars": true,
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://zorionapp.midnightpoetry.studio",
    "SITE_ORIGIN": "https://zorion.midnightpoetry.studio",
    "PLACES_PROVIDER": "osm",
    // Free routed trip times (Admin > Categories & rules > OpenStreetMap routing). These are the public servers
    // run by FOSSGIS: one request a second, no guarantee of availability. Point them at your own OSRM for real traffic.
    "OSRM_FOOT_URL": "https://routing.openstreetmap.de/routed-foot",
    "OSRM_BIKE_URL": "https://routing.openstreetmap.de/routed-bike"
  }
  // Secrets (set with `wrangler secret put`): DATABASE_URL, PEPPER, TOTP_KEY, RESEND_API_KEY, EMAIL_FROM,
  // GOOGLE_PLACES_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_MONTHLY, STRIPE_PRICE_YEARLY
  // Optional: TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME and TELEGRAM_WEBHOOK_SECRET (updates on Telegram; the app connects the bot by itself),
  // ORS_API_KEY (openrouteservice, free plan), GOOGLE_ROUTES_KEY (falls back to GOOGLE_PLACES_KEY), OVERPASS_URL and NOMINATIM_URL (your own map servers)
}
