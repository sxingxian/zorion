{
  "name": "zorion",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p packages/db && tsc -p apps/app && tsc -p apps/site",
    "test": "vitest run",
    "build": "npm run build -w @zorion/app && npm run build -w @zorion/site",
    "migrate": "node packages/db/migrate.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "tsx scripts/demo.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "telegram:setup": "node scripts/telegram-setup.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
